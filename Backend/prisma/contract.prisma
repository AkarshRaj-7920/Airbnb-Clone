// use prisma-8

// User Model
model User {
    id              String                      @id @default(uuid())

    firstName       String
    lastName        String

    email           String                      @unique
    password        String?

    phoneNumber     String?                     @unique

    emailVerified   Boolean   
    phoneVerified   Boolean
   
    createdAt       TimestamptzString           @default(now())
    updatedAt       temporal.updatedAtString()
}